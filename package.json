{
  "name": "crosslister",
  "version": "0.1.0",
  "description": "A free, self-hosted crosslisting app for one person: create a listing once (photos, title, price, condition, brand, category, size), then publish it to Mercari, Poshmark, Depop, Facebook Marketplace, eBay, Grailed and more. Runs locally on a Mac — no cloud, no subscription.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "RUN_BROWSER_TESTS=1 vitest run tests/browser",
    "db:generate": "drizzle-kit generate",
    "calibrate": "tsx src/server/scripts/calibrate.ts",
    "fixtures": "tsx src/server/scripts/fixtureServer.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshbelot/crosslister.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/joshbelot/crosslister/issues"
  },
  "homepage": "https://github.com/joshbelot/crosslister#readme",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.5",
    "@tanstack/react-query": "^5.104.1",
    "@types/yauzl": "^3.4.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.6",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.5",
    "lucide-react": "^1.53.0",
    "nanoid": "^6.0.2",
    "node-html-parser": "^9.0.4",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^20.1.2",
    "react-easy-crop": "^6.2.4",
    "react-router": "^7.18.4",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
